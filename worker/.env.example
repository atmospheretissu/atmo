# ---------- Shared Supabase (same project as Atmo) ----------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ---------- Leroy Merlin partner portal credentials ----------
# NEVER commit these. Set via Railway env vars only.
LM_PARTNER_LOGIN=
LM_PARTNER_PASSWORD=

# ---------- Worker ----------
# Used by Railway healthcheck and (optionally) by the dashboard to trigger jobs
PORT=3000
# Optional: signed bearer the dashboard must send to /trigger
WORKER_TRIGGER_SECRET=

# How often we poll the jobs queue (ms). The cron itself is in DB (atmolead_config.cron_expression)
JOB_POLL_INTERVAL_MS=15000

# Set to "true" to log full Playwright traces (heavy — debug only)
DEBUG_TRACE=false
