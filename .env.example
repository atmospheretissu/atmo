# =====================================================================
# Atmosphère Tissus — environment variables
# Copy this file to .env.local and fill in your values.
# DO NOT commit .env.local — it is git-ignored.
# =====================================================================

# ---------- Supabase ----------
# Found in: Supabase Dashboard → Project Settings → API
# Region matters: prefer EU (Frankfurt / Paris) for RGPD compliance.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# Service role key — server-side only, NEVER expose to client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ---------- Stripe ----------
# Test mode while in beta. Switch to live keys when going to production.
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxx
STRIPE_SECRET_KEY=sk_test_xxxxx
# Webhook signing secret — generated when you create the webhook endpoint
# in Stripe dashboard (or via `stripe listen` CLI for local dev).
STRIPE_WEBHOOK_SECRET=whsec_xxxxx

# ---------- Brevo (SMS / Email) ----------
# Sender name "ATMOSPHERE" must be configured in Brevo dashboard
BREVO_API_KEY=xkeysib-xxxxx
BREVO_SENDER_NAME=ATMOSPHERE
BREVO_SENDER_EMAIL=contact@atmospheretissus.fr

# ---------- Pennylane ----------
# Accreditation in progress (PDP). Plug when API is generally available.
PENNYLANE_API_TOKEN=
PENNYLANE_COMPANY_ID=

# ---------- App ----------
# Public base URL — used in emails, redirects, webhook callbacks
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="Atmosphère Tissus"

# Optional — useful for cron jobs and signed admin operations
APP_ADMIN_SECRET=generate-a-random-32-byte-string-here
